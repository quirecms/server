# Defaults of the agent's settings. The real ones come from /srv/quire/server/server.env through
# compose.yaml: secrets are never here.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
QUIRE_SERVER_ROOT=/srv/quire
DOCKER_HOST=tcp://docker-proxy:2375
DATABASE_URL=
QUIRE_SERVER_POSTGRES_ADMIN_URL=
QUIRE_SERVER_MAILER_DSN=
QUIRE_SERVER_QUIRE_VERSION=^0.1
QUIRE_SERVER_GIT_POLL_SECONDS=300
# The hour (UTC) from which sites get their automatic updates each night, or "off"
QUIRE_SERVER_UPDATE_HOUR=3
QUIRE_SERVER_VERSION=dev
QUIRE_SERVER_IMAGE=
# Backups off the server (quire-server backups:setup writes them to server.env)
QUIRE_SERVER_BACKUP_REPOSITORY=
QUIRE_SERVER_BACKUP_ACCESS_KEY=
QUIRE_SERVER_BACKUP_SECRET_KEY=
QUIRE_SERVER_BACKUP_PASSWORD=
QUIRE_SERVER_BACKUP_REGION=us-east-1
QUIRE_SERVER_BACKUP_HOST=quire-server
QUIRE_SERVER_BACKUP_HOUR=2
QUIRE_SERVER_BACKUP_KEEP="7 daily, 4 weekly, 6 monthly"
# The updater only (compose.yaml's "updater" service: quire-server update)
QUIRE_SERVER_UPDATER=0
QUIRE_SERVER_POSTGRES_PASSWORD=
QUIRE_SERVER_UPDATE_WAIT_SECONDS=300
