# The server's settings and secrets. Copy to server.env (only root may read it) and fill in; the
# installer does this for you. See README.md.

# The agent's image: a release's, by digest, after its signature was checked (install.sh writes it), or
# none to build it from this folder, with compose.build.yaml added here. A PostgreSQL major other than
# compose.yaml's adds its file here (database/postgres-19.yaml): "quire-server database:upgrade" does.
COMPOSE_FILE=compose.yaml
QUIRE_SERVER_IMAGE=

# Secrets: long random values, e.g. from "openssl rand -hex 32". Keep them.
QUIRE_SERVER_APP_SECRET=
QUIRE_SERVER_POSTGRES_PASSWORD=
QUIRE_SERVER_DATABASE_PASSWORD=

# Let's Encrypt writes here about certificates (expiry, problems).
QUIRE_SERVER_ACME_EMAIL=

# The email server new sites send with (invitations, password resets), e.g.
# smtp://user:pass@smtp.example.com:587, and the server's own notifications. Empty: sites send no
# email until you set theirs.
QUIRE_SERVER_MAILER_DSN=

# Who hears of problems ("quire-server status"): failed nightly backups, updates and deploys,
# certificates that don't come, a disk filling up. Told once when one starts, each week while it
# lasts, once when it's over. By email (to QUIRE_SERVER_ACME_EMAIL unless set here; from the same
# address unless QUIRE_SERVER_NOTIFY_FROM is set), through QUIRE_SERVER_MAILER_DSN; and/or a webhook
# (https://, Slack's and Discord's incoming webhooks included), each request signed with the secret:
# X-Quire-Signature-256: sha256=<HMAC-SHA256 of the body> ("openssl rand -hex 32" makes one).
# "quire-server notify:test" tries them.
QUIRE_SERVER_NOTIFY_EMAIL=
QUIRE_SERVER_NOTIFY_FROM=
QUIRE_SERVER_NOTIFY_WEBHOOK=
QUIRE_SERVER_NOTIFY_SECRET=
# What you call this server, in each message (e.g. when you have several)
QUIRE_SERVER_NAME=

# The Quire version new sites get.
QUIRE_SERVER_QUIRE_VERSION=^0.1

# The private range sites' networks get their addresses from (a /26 per site: a /16 holds 1,024 sites).
# The installer sets it (--site-networks), and refuses one the machine's routes overlap (a VPC, a VPN).
# Changing it later applies to sites added from then on: sites keep the addresses they have. A wider
# range that holds this one gives room for more. "quire-server up" and "update" say so when the
# machine's routes overlap it.
QUIRE_SERVER_SITE_NETWORKS=10.72.0.0/16

# Connections the server's PostgreSQL takes: sized from the machine's memory by the installer and by
# "quire-server up" (3 a site it can hold, 200 to 1,000), which write it here. A machine resized
# gets its new value at the next "quire-server up" (PostgreSQL starts again: a few seconds offline).
QUIRE_SERVER_DATABASE_CONNECTIONS=

# Memory a site's build may take (MB): a new site (site:add, restore --as, adoption) isn't built
# while less is free, rather than run the machine out of memory. Updates aren't held back.
QUIRE_SERVER_BUILD_MEMORY_MB=1536

# Git mode sites that deploy by themselves: how often their branch is asked for new commits (seconds).
QUIRE_SERVER_GIT_POLL_SECONDS=300

# Sites' automatic updates ("quire-server site:updates"): every night from this hour (UTC), or "off"
# for none on this server.
QUIRE_SERVER_UPDATE_HOUR=3

# Backups off the server: "quire-server backups:setup" sets these (restic, on S3-compatible storage;
# keep the password and keys somewhere else too). Every night from the hour (UTC), or "off"; kept as
# QUIRE_SERVER_BACKUP_KEEP says.
QUIRE_SERVER_BACKUP_REPOSITORY=
QUIRE_SERVER_BACKUP_ACCESS_KEY=
QUIRE_SERVER_BACKUP_SECRET_KEY=
QUIRE_SERVER_BACKUP_PASSWORD=
QUIRE_SERVER_BACKUP_REGION=us-east-1
QUIRE_SERVER_BACKUP_HOUR=2
QUIRE_SERVER_BACKUP_KEEP=7 daily, 4 weekly, 6 monthly
