#!/bin/sh
# quire-server: manage this machine's Quire sites. Installed as /usr/local/bin/quire-server.
#
#   quire-server site:add jane --domain=jane.example --admin-email=jane@example.com
#   quire-server site:adopt demo                (a site installed before the server)
#   quire-server site:update jane | site:undo jane | site:audit jane
#   quire-server site:key blog | site:deploy blog | site:poll blog on   (Git mode)
#   quire-server site:list | site:remove jane | operations
#   quire-server update [--to=X.Y.Z] [--check] [--undo]   (the server itself, to a newer release)
#   quire-server up | down | logs | ps          (the server itself)
#
# Runs as root (it acts on Docker); everything it does is recorded with who asked.
set -eu

root=${QUIRE_SERVER_ROOT:-/srv/quire}
compose() {
	docker compose --project-directory "$root/server" --env-file "$root/server/server.env" "$@"
}

if [ "$(id -u)" -ne 0 ]; then
	echo 'quire-server must run as root, e.g. with sudo.' >&2
	exit 1
fi

# Compose reads COMPOSE_FILE (server.env) relative to where it runs.
cd "$root/server"

case "${1:-help}" in
	up) shift; compose up --detach --wait "$@" ;;
	down) shift; compose down "$@" ;;
	logs) shift; compose logs "$@" ;;
	ps) shift; compose ps "$@" ;;
	help|-h|--help) compose exec -T agent bin/console list server ;;
	update)
		# In the updater, not the agent (it replaces the agent): one at a time, its name says so.
		shift
		tty=-T
		if [ -t 0 ] && [ -t 1 ]; then tty=; fi
		if docker ps -a --format '{{.Names}}' | grep -qx quire-server-updater; then
			echo 'An update runs already ("docker logs -f quire-server-updater" follows it).' >&2
			exit 1
		fi
		exec docker compose --project-directory "$root/server" --env-file "$root/server/server.env" --profile update \
			run --rm --no-deps --name quire-server-updater $tty -e "QUIRE_SERVER_REQUESTED_BY=${SUDO_USER:-$(id -un)}" updater bin/console server:update "$@"
		;;
	*)
		command=$1
		shift
		case "$command" in
			*[!a-z:-]*) echo "Unknown command: $command" >&2; exit 1 ;;
		esac
		# A terminal when there is one (questions, colours).
		tty=-T
		if [ -t 0 ] && [ -t 1 ]; then tty=; fi
		exec docker compose --project-directory "$root/server" --env-file "$root/server/server.env" \
			exec $tty -e "QUIRE_SERVER_REQUESTED_BY=${SUDO_USER:-$(id -un)}" agent bin/console "server:$command" "$@"
		;;
esac
