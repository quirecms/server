# The server's settings and secrets. Copy to server.env (only root may read it) and fill in; the
# installer does this for you. See README.md.

# Secrets: long random values, e.g. from "openssl rand -hex 32". Keep them.
QUIRE_SERVER_APP_SECRET=
QUIRE_SERVER_POSTGRES_PASSWORD=
QUIRE_SERVER_DATABASE_PASSWORD=

# Let's Encrypt writes here about certificates (expiry, problems).
QUIRE_SERVER_ACME_EMAIL=

# The email server new sites send with (invitations, password resets), e.g.
# smtp://user:pass@smtp.example.com:587. Empty: sites send no email until you set theirs.
QUIRE_SERVER_MAILER_DSN=

# The Quire version new sites get.
QUIRE_SERVER_QUIRE_VERSION=^0.1
