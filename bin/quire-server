#!/bin/sh
# quire-server: manage this machine's Quire sites. Installed as /usr/local/bin/quire-server.
#
#   quire-server site:add jane --domain=jane.example --admin-email=jane@example.com
#   quire-server site:adopt demo                (a site installed before the server)
#   quire-server site:update jane | site:undo jane | site:audit jane
#   quire-server site:key blog | site:deploy blog | site:poll blog on   (Git mode)
#   quire-server site:list | site:remove jane | operations | status (what needs you) | notify:test
#   quire-server update [--to=X.Y.Z] [--check] [--undo]   (the server itself, to a newer release)
#   quire-server database:upgrade [--check] [--to=19] [--undo] [--clean]   (its PostgreSQL, to a newer major)
#   quire-server backups:setup | backups jane | backups:now [jane] | backups:restore jane | backups:check
#   quire-server settings | settings:set NAME=value   (server.env, without its secrets)
#   quire-server up | down | logs | ps          (the server itself)
#
# Runs as root (it acts on Docker); everything it does is recorded with who asked.
set -eu

root=${QUIRE_SERVER_ROOT:-/srv/quire}
compose() {
	docker compose --project-directory "$root/server" --env-file "$root/server/server.env" "$@"
}

if [ "$(id -u)" -ne 0 ]; then
	echo 'quire-server must run as root, e.g. with sudo.' >&2
	exit 1
fi

# up and down recreate or stop the agent, which ends what it runs (a deploy in the middle of its swap
# included): they wait for nothing to run, unless --force is given.
force=0
for argument in "$@"; do
	if [ "$argument" = --force ]; then force=1; fi
done
quiet() {
	if [ "$force" = 1 ]; then return 0; fi
	if ! running=$(compose exec -T agent bin/console server:busy 2>/dev/null); then
		if [ -n "$running" ]; then
			echo "An operation runs ($running): it would be cut short. Try again when it's finished (\"quire-server operations\"), or add --force." >&2
			exit 1
		fi
	fi
}

# The updater runs one command at a time (update, backups:setup, database:upgrade), in a container of
# that name: refused while one runs. One that has ended is removed by "compose run --rm" a moment
# after it exits, longer on a busy machine: it was taken for a running one, and the next command
# refused. A finished one is waited for, then removed if it's still there.
updater_state() {
	# A container that isn't there: docker inspect fails, and still prints an empty line
	state=$(docker inspect --format '{{.State.Status}}' quire-server-updater 2>/dev/null) || state=none
	echo "${state:-none}"
}
updater_free() {
	waited=0
	while :; do
		case "$(updater_state)" in
			none) return 0 ;;
			running | restarting | paused)
				running=$(docker inspect --format '{{range .Config.Cmd}}{{.}} {{end}}' quire-server-updater 2>/dev/null | sed -n 's/.*server:\([a-z:-]*\).*/\1/p')
				echo "quire-server ${running:-update} runs already (\"docker logs -f quire-server-updater\" follows it). Try again when it's finished." >&2
				exit 1
				;;
		esac
		# Ended (or made and never started): on its way out
		if [ "$waited" -ge 30 ]; then
			docker rm --force quire-server-updater >/dev/null 2>&1 || true
			[ "$(updater_state)" = none ] && return 0
			echo 'The updater of an earlier command is still there and can'\''t be removed: "docker rm --force quire-server-updater", then try again.' >&2
			exit 1
		fi
		sleep 1
		waited=$((waited + 1))
	done
}

# Whether the front door publishes ports 80 and 443
front_ports() {
	compose port front 80 >/dev/null 2>&1 && compose port front 443 >/dev/null 2>&1
}

# An update of the server the machine's stop cut short: said first, whatever is asked.
if [ -f "$root/backups/server/swap.json" ] && ! docker ps --format '{{.Names}}' | grep -qx quire-server-updater; then
	echo "An update of the server was cut short (the machine stopped in the middle): \"quire-server update --undo\" puts it back as it was." >&2
fi

# Compose reads COMPOSE_FILE (server.env) relative to where it runs.
cd "$root/server"
# shellcheck source=/dev/null
. "$root/server/bin/site-range.sh"
# shellcheck source=/dev/null
. "$root/server/bin/database-connections.sh"

case "${1:-help}" in
	up)
		shift
		quiet
		for argument do shift; [ "$argument" = --force ] || set -- "$@" "$argument"; done
		# A network added on the sites' range since the install (it starts anyway: said, not refused)
		site_range_warn "$root/server"
		# PostgreSQL's connections for this machine's memory (D-39): a resized machine changes them,
		# and PostgreSQL starts again with them here
		database_connections_sync "$root/server" >&2
		compose up --detach --wait "$@"
		# The front door has no health check: after a port was taken, it can run without its ports.
		if ! front_ports; then
			echo 'The front door runs without its ports: starting it again.' >&2
			compose up --detach --wait --force-recreate front
			if ! front_ports; then
				echo 'The front door can'\''t publish ports 80 and 443: another program uses them ("ss -ltnp" shows which). Every site is offline until it can.' >&2
				exit 1
			fi
		fi
		# Containers made again (the front door, PostgreSQL) are back on sites' links now, not at the
		# agent's next round.
		compose exec -T agent bin/console server:links --quiet || echo 'The agent couldn'\''t put sites'\'' links back yet: it does at its next round (within a minute).' >&2
		;;
	down)
		shift
		# Its volumes are the server's PostgreSQL (every site's database) and the front door's certificates.
		for argument in "$@"; do
			case "$argument" in
				-v | --volumes | --volumes=* | --rmi | --rmi=* | -[a-z]*v*)
					echo "quire-server down keeps the server's data: \"$argument\" would delete every site's database and the server's registry (or its images). It isn't passed on." >&2
					exit 1
					;;
			esac
		done
		quiet
		for argument do shift; [ "$argument" = --force ] || set -- "$@" "$argument"; done
		compose down "$@"
		;;
	logs) shift; compose logs "$@" ;;
	ps) shift; compose ps "$@" ;;
	help | -h | --help | list) compose exec -T agent bin/console server:help ;;
	--version | -V) compose exec -T agent bin/console server:version ;;
	update | backups:setup | database:upgrade | settings | settings:set)
		# In the updater, not the agent (it replaces the agent or PostgreSQL, or saves server.env): one at a time,
		# its name says so. Secrets for automation come from the environment, never from arguments.
		command=$1
		shift
		if [ "$command" = update ]; then site_range_warn "$root/server"; fi
		tty=-T
		if [ -t 0 ] && [ -t 1 ]; then tty=; fi
		updater_free
		exec docker compose --project-directory "$root/server" --env-file "$root/server/server.env" --profile update \
			run --rm --no-deps --name quire-server-updater $tty -e "QUIRE_SERVER_REQUESTED_BY=${SUDO_USER:-$(id -un)}" \
			-e QUIRE_SERVER_BACKUP_SETUP_SECRET_KEY -e QUIRE_SERVER_BACKUP_SETUP_PASSWORD \
			updater bin/console "server:$command" "$@"
		;;
	*)
		# As the agent names it ("server:site:add") or as it's typed ("site:add"): the same command
		command=${1#server:}
		shift
		case "$command" in
			*[!a-z:-]*) echo "Unknown command: $command" >&2; exit 1 ;;
		esac
		# Without the agent, nothing can be done: said, rather than Compose's 'service "agent" is not running'
		if [ -z "$(compose ps --status running --quiet agent 2>/dev/null)" ]; then
			echo 'The agent isn'\''t running, so nothing can be done: "quire-server up" starts it again; "quire-server logs agent" says why it stopped. The sites run without it.' >&2
			exit 1
		fi
		# A terminal when there is one (questions, colours).
		tty=-T
		if [ -t 0 ] && [ -t 1 ]; then tty=; fi
		status=0
		# A command's help names it as it's typed, without the agent's "server:" (OWNER-11)
		case " $* " in
			*' --help '* | *' -h '*)
				docker compose --project-directory "$root/server" --env-file "$root/server/server.env" \
					exec -T agent bin/console "server:$command" "$@" | sed 's/server:\([a-z]\)/\1/g' || status=$?
				exit "$status"
				;;
		esac
		docker compose --project-directory "$root/server" --env-file "$root/server/server.env" \
			exec $tty -e "QUIRE_SERVER_REQUESTED_BY=${SUDO_USER:-$(id -un)}" -e "QUIRE_SERVER_HOST_NAME=$(hostname)" agent bin/console "server:$command" "$@" || status=$?
		# Killed with the agent (a restart, "up", the machine's stop): it says nothing of it itself.
		if [ "$status" -eq 137 ] || [ "$status" -eq 143 ]; then
			echo "The agent stopped while it ran this: it puts back what was left half done when it starts again. \"quire-server operations\" shows what happened; then run it again." >&2
		fi
		exit "$status"
		;;
esac
