# The front door: the only part of the server visitors reach. It holds every site's certificate and
# passes each request to the site whose domain it names. What it may serve is a file per domain in
# /srv/quire/server/domains, which only the agent writes: no PHP here, and no reload when sites change.
{
	# "email you@example.com" when QUIRE_SERVER_ACME_EMAIL is set (compose.yaml); nothing otherwise.
	{$QUIRE_SERVER_ACME_EMAIL_OPTION}
	# Certificates as visitors first come, for allowed domains only (asked of the site below).
	on_demand_tls {
		ask http://127.0.0.1:9180/allowed
	}
	# Nothing reaches Caddy's admin API: the configuration never changes at runtime.
	admin off
	# Caddy's own messages, e.g. a certificate obtained for a visitor's first visit, name the visitor
	# too: cut to the network like visits are (SEC-0010; visits are the "log" below).
	log default {
		format filter {
			wrap json
			fields {
				remote_ip ip_mask 24 48
				client_ip ip_mask 24 48
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>True-Client-Ip delete
			}
		}
	}
	{$QUIRE_SERVER_TLS_GLOBAL}
}

# Whether a domain may get a certificate: only on this container's loopback, for Caddy itself.
http://127.0.0.1:9180 {
	bind 127.0.0.1
	@allowed {
		path /allowed
		expression `{query.domain}.matches("^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")`
		file {
			root /srv/quire/server/domains
			try_files {query.domain}
		}
	}
	respond @allowed 200
	respond 404
}

https:// {
	tls {
		on_demand
	}

	# Only a domain the server has, asked for by the same name it's encrypted for: so a forged Host
	# header can't reach another container on the network.
	@site {
		# One expression: Caddy keeps only one "expression" per matcher, so two would silently drop one.
		expression `{host}.matches("^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$") && {host} == {http.request.tls.server_name}`
		file {
			root /srv/quire/server/domains
			try_files {host}
		}
	}

	handle @site {
		# The site's own headers (Quire sends its security headers); these are defaults for older sites.
		header ?Strict-Transport-Security "max-age=31536000"
		header ?X-Content-Type-Options "nosniff"
		header -Server
		# By its name on quire-edge only, which no public DNS answers (see SiteFiles::EDGE_SUFFIX)
		reverse_proxy {host}.quire.internal:80 {
			# A site that's down or restarting: tell visitors, don't hang.
			lb_try_duration 10s
		}
	}

	handle {
		respond "Misdirected request" 421
	}

	# The site's containers are gone for a moment (an update, a restart): a page saying so, as 503 with
	# Retry-After so search engines come back instead of dropping the page. (Errors the site itself
	# answers with pass through as they are.)
	handle_errors 502 503 504 {
		header Retry-After 30
		header Cache-Control no-store
		root * /etc/caddy/pages
		rewrite * /unavailable.html
		file_server {
			status 503
		}
	}

	# Visits, without the visitor (SEC-0010): the address is cut to its network (/24 for IPv4, /48 for
	# IPv6) as the line is written, so a full IP is never stored, and the headers that can carry one
	# are left out. Abuse is still seen by network. How long lines stay is compose.yaml's size cap.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>True-Client-Ip delete
			}
		}
	}
}

http:// {
	# A domain the server has: to HTTPS. Any other: said so, here (NOVICE-11), rather than sent to an
	# HTTPS address that has no certificate and fails in the visitor's browser. (The certificate
	# authority's HTTP challenge is answered by Caddy before this, for the domains it may serve.)
	@site {
		expression `{host}.matches("^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")`
		file {
			root /srv/quire/server/domains
			try_files {host}
		}
	}

	redir @site https://{host}{uri} 308
	respond "No site here" 404
}
